    {
      "id": "e1",
      "name": "Buscar conteudo de entrega",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -160
      ],
      "notes": "Le entrega_texto do catalogo. O conteudo mora no banco e nao no workflow: quando o padre trocar um audio ou o link do grupo mudar, e um UPDATE, sem republicar workflow.",
      "parameters": {
        "method": "GET",
        "url": "=https://rmvmqmcfcjmcjtonewgi.supabase.co/rest/v1/produtos?select=produto_id,nome,entrega_texto",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpCustomAuth"
      },
      "credentials": {
