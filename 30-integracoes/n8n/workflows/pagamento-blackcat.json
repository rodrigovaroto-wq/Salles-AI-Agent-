    {
      "id": "n17",
      "name": "Selecionar proximo produto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        -160
      ],
      "notes": "Oferece o order_bump de maior prioridade (ordem.asc) que o lead ainda nao comprou. Nunca reoferece algo ja pago -- confere pelo produto_id gravado em items no momento da compra (title usado como fallback se produto_id nao veio no item historico).",
      "parameters": {
        "jsCode": "const catalogo = ($node[\"Buscar produtos (upsell)\"].json || []);\nconst lead = ($node[\"Buscar lead atualizado\"].json || [])[0] || {};\nconst comprados = lead.produtos_comprados || [];\nconst idsComprados = new Set(comprados.map(i => i.produto_id || i.title));\n\nconst candidatos = catalogo\n  .filter(p => p.tipo !== 'principal')\n  .filter(p => !idsComprados.has(p.produto_id) && !idsComprados.has(p.nome))\n  .sort((a, b) => a.ordem - b.ordem);\n\nconst proximo = candidatos[0] || null;\nreturn [{ json: { tem_upsell: !!proximo, produto: proximo } }];"
      }
    },
