    {
      "id": "n17",
      "name": "Selecionar proximo produto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -160
      ],
      "notes": "Oferece o order_bump de maior prioridade (ordem.asc) que o lead ainda nao comprou. Bloqueia totalmente a oferta se o lead estiver em opt_out (LGPD) ou aguardando_humano (escalado por sofrimento real) -- nesses casos vender seria violacao de compliance, nao perda de receita.",
      "parameters": {
        "jsCode": "const catalogo = ($node[\"Buscar produtos (upsell)\"].json || []);\nconst lead = ($node[\"Buscar lead atualizado\"].json || [])[0] || {};\n\n// Nunca oferecer nada a quem pediu para parar (LGPD/compliance secao 5) nem a quem\n// foi escalado por sofrimento real -- vender nesse momento seria exatamente o que\n// objecoes.md secao P proibe.\nconst bloqueado = lead.status === \"opt_out\" || lead.status === \"aguardando_humano\";\nif (bloqueado) return [{ json: { tem_upsell: false, produto: null, motivo: lead.status } }];\n\nconst comprados = lead.produtos_comprados || [];\n// O item gravado vem do BlackCat, que carrega \"title\" (o nome), nao produto_id --\n// por isso a comparacao aceita as duas formas.\nconst idsComprados = new Set(comprados.map(i => i.produto_id || i.title));\n\nconst candidatos = catalogo\n  .filter(p => p.tipo !== \"principal\")\n  .filter(p => !idsComprados.has(p.produto_id) && !idsComprados.has(p.nome))\n  .sort((a, b) => a.ordem - b.ordem);\n\nconst proximo = candidatos[0] || null;\nif (!proximo) return [{ json: { tem_upsell: false, produto: null, mensagem: null, motivo: \"ja_tem_tudo\" } }];\n\n// Preco formatado a partir do catalogo, nunca hardcoded.\nconst preco = (proximo.preco_centavos / 100).toFixed(2).replace(\".\", \",\");\nconst mensagem = \"Aproveitando que voce ja garantiu a sua protecao: quer completar com *\"\n  + proximo.nome + \"* por apenas R$ \" + preco\n  + \"? Se quiser, me diz \\\"sim\\\" que eu ja te mando o link.\";\n\nreturn [{ json: { tem_upsell: true, produto: proximo, mensagem, motivo: null } }];"
      }
    },
