      },
      "id": "pm-a4",
      "name": "Marcar cancelada",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1000,
        60
      ],
      "notes": "Cancelamento. A cliente mantem o acesso ate o fim do periodo ja pago -- por isso so marcamos a data, sem mexer em proxima_cobranca.",
      "credentials": {
        "httpCustomAuth": {
