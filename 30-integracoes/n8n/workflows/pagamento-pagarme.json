      ],
      "notes": "Cartao cadastrado com sucesso: a assinatura vira trial de 30 dias e a primeira cobranca fica marcada para o dia 30. Upsert, entao recadastro do cartao nao duplica linha.",
      "credentials": {
        "httpCustomAuth": {
          "id": "9XxwNt8U6u5tce4w",
          "name": "SUPABASE"
        }
      }
    },
    {
