      "notes": "Renovacao confirmada: empurra proxima_cobranca 30 dias e tira de inadimplente se estava. A idempotencia acima e o que impede este PATCH de rodar duas vezes no mesmo evento.",
      "credentials": {
        "httpCustomAuth": {
          "id": "9XxwNt8U6u5tce4w",
          "name": "SUPABASE"
        }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://rmvmqmcfcjmcjtonewgi.supabase.co/rest/v1/assinaturas?lead_id=eq.{{ $node[\"Normalizar evento\"].json.lead_id }}&produto_id=eq.{{ $node[\"Normalizar evento\"].json.produto_id }}",
        "sendHeaders": true,
