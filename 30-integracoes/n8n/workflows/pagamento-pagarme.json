        "genericAuthType": "httpCustomAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { status: 'ativa', ultimo_pagamento: new Date().toISOString(), proxima_cobranca: new Date(Date.now() + 30*86400000).toISOString() } }}"
      },
      "id": "pm-a1",
      "name": "Renovacao paga",
