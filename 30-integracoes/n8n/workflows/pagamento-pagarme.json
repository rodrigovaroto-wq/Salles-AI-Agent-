      ],
      "notes": "Tipo que nao acionamos (subscription.updated, invoice.*)."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://rmvmqmcfcjmcjtonewgi.supabase.co/rest/v1/assinaturas?lead_id=eq.{{ $node[\"Normalizar evento\"].json.lead_id }}&produto_id=eq.{{ $node[\"Normalizar evento\"].json.produto_id }}",
        "sendHeaders": true,
        "headerParameters": {
